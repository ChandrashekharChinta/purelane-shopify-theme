<!-- ================= PROOF ================= -->
<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.description }}</p>
          {% if section.settings.cta_text and section.settings.cta_url %}
            <a class="btn btn-primary" href="{{ section.settings.cta_url }}">
              {{ section.settings.cta_text }}
              {% include 'icon' icon: 'arrow-right' %}
            </a>
          {% endif %}
        </div>

        <div class="glass-2 proof-stats">
          {%- for block in section.blocks -%}
            <div class="stat">
              <div class="ring">{{ block.settings.stat_value }}</div>
              <h5>{{ block.settings.stat_label }}</h5>
              <p>{{ block.settings.stat_description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime. Gentle on everything else."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "stat_description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof",
      "blocks": [
        { "type": "stat", "settings": { "stat_value": "99.9%", "stat_label": "Germ kill", "stat_description": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "stat_value": "0%", "stat_label": "Sulphates", "stat_description": "No SLS, chlorine or parabens" } },
        { "type": "stat", "settings": { "stat_value": "100%", "stat_label": "Plant based", "stat_description": "Cleansers derived from plants" } },
        { "type": "stat", "settings": { "stat_value": "4.8", "stat_label": "Rated", "stat_description": "Across 8,000+ verified reviews" } }
      ]
    }
  ]
}
{% endschema %}
