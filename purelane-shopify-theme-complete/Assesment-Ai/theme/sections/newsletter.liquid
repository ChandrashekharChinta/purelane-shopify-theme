<!-- ================= SIGNUP ================= -->
<section class="sec rv" id="signup" data-scene="4" style="background: var(--g-bg)">
  <div class="wrap">
    <div class="glass sec-pad" style="max-width:600px;margin:0 auto;text-align:center">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <p class="body-s" style="margin:18px 0">{{ section.settings.description }}</p>
      
      <form method="post" action="/contact#newsletter" class="newsletter-form" style="display:flex;gap:12px;margin-top:24px">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder }}" required style="flex:1;padding:12px 18px;border:1px solid var(--g-line);border-radius:var(--r-sm);background:rgba(255,255,255,.08)">
        <button type="submit" class="btn btn-primary">{{ section.settings.button_text }}</button>
      </form>
      <p class="body-s" style="margin-top:12px;opacity:.6">{{ section.settings.privacy_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Stay updated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get cleaning tips & new launches"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy text",
      "default": "We respect your inbox. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
